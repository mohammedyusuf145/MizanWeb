# ─── Browser (safe to expose: protected by Row Level Security) ───────────────
# Leave both empty to run Mizan in local demo mode (no account, data stays in this browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Edge Function secrets (NEVER prefix with VITE_, never commit) ─────────
# Set with: supabase secrets set ANTHROPIC_API_KEY=... TUTOR_MODEL=...
# ANTHROPIC_API_KEY=
# TUTOR_MODEL=claude-sonnet-5-5
# TUTOR_MODEL_LIGHT=claude-haiku-5-5
# TUTOR_DAILY_MESSAGE_CAP=60
# TUTOR_DAILY_TOKEN_CAP=150000
